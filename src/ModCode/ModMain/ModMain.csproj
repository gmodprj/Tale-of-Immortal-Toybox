<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 게임 내 모드 에디터가 발급한 모드 ID. 바꿀 때 .cs 파일의 네임스페이스도 함께 바꾼다. -->
    <ModId Condition="'$(ModId)' == ''">sWP6UL</ModId>
    <!-- 모드 에디터가 만든 프로젝트. "게임 디버깅 시작"이 이 폴더의 bin\Release에 있는 DLL을 게임으로 복사한다. -->
    <EditorReleaseDir>$(MSBuildProjectDirectory)\..\..\..\ModProject_$(ModId)\ModProject\ModCode\ModMain\bin\Release</EditorReleaseDir>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>MOD_$(ModId)</AssemblyName>
    <RootNamespace>MOD_$(ModId)</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <!-- SDK가 InformationalVersion 뒤에 +<전체 커밋>을 붙이는 것을 끈다. 표지는 StampCommit가 넣는 <짧은 커밋>[-dirty]만. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- 모드 에디터는 bin\Release의 모든 DLL을 게임으로 복사한다. 산출물은 DLL 하나여야 한다. -->
    <!-- 개발용 탐침과 명령 채널(Dev 폴더). 배포 빌드는 -p:DevTools=false 로 뺀다. -->
    <DevTools Condition="'$(DevTools)' == ''">true</DevTools>
    <DefineConstants Condition="'$(DevTools)' == 'true'">$(DefineConstants);DEVTOOLS</DefineConstants>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <GameDir Condition="'$(GameDir)' == ''">E:\Games\Tale of Immortal</GameDir>
    <ManagedDir>$(GameDir)\MelonLoader\Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(GameDir)\MelonLoader\MelonLoader.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\MelonLoader\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(ManagedDir)\Il2Cppmscorlib.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnhollowerBaseLib">
      <HintPath>$(ManagedDir)\UnhollowerBaseLib.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnhollowerRuntimeLib"><HintPath>$(ManagedDir)\UnhollowerRuntimeLib.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(DevTools)' != 'true'">
    <Compile Remove="Dev\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 기본 프리셋. DLL 안에 넣어 두고 presets 폴더가 없을 때 풀어 놓는다(산출물은 DLL 하나여야 한다). 이름은 "Presets/<파일 이름>"이다. -->
    <EmbeddedResource Include="Presets\*.json" LogicalName="Presets/%(Filename)%(Extension)" />
    <!-- 창작마당 모드 글의 번역. DLL 안에 넣어 두고 translations 폴더에 파일이 없을 때 풀어 놓는다. 이름은 "Translations/mods.txt"다. -->
    <EmbeddedResource Include="Translations\*.txt" LogicalName="Translations/%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- 커밋 표지: InformationalVersion = <짧은 커밋>[-dirty]. Init 로그(BuildInfo.Commit)와 install.ps1이 읽는다(05 문서 49절). git이 없으면 unknown.
       GenerateAssemblyInfo가 속성 값으로 캐시를 만들므로 커밋만 바뀌어도 다시 컴파일된다. -->
  <Target Name="StampCommit" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo">
    <!-- ConsoleToMSBuild는 stderr도 담으므로 2>nul로 버리고, 짧은 해시 꼴이 아니면 unknown으로 둔다(git이 없거나 저장소 밖일 때). -->
    <Exec Command="git rev-parse --short HEAD 2&gt;nul" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommit" />
    </Exec>
    <Exec Command="git status --porcelain 2&gt;nul" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitDirty" />
    </Exec>
    <PropertyGroup>
      <GitCommit Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(GitCommit)', '^[0-9a-f]{7,40}$'))">unknown</GitCommit>
      <InformationalVersion>$(GitCommit)</InformationalVersion>
      <InformationalVersion Condition="'$(GitCommit)' != 'unknown' And '$(GitDirty)' != ''">$(GitCommit)-dirty</InformationalVersion>
    </PropertyGroup>
  </Target>
  <Target Name="CopyToEditorProject" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' And Exists('$(EditorReleaseDir)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(EditorReleaseDir)" />
    <Message Importance="high" Text="copied $(TargetFileName) -> $(EditorReleaseDir)" />
  </Target>

</Project>
